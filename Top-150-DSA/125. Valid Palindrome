class Solution {
public:

    bool check(char c) {
    return (c >= 'a' && c <= 'z') || 
           (c >= 'A' && c <= 'Z') || 
           (c >= '0' && c <= '9');
           }

    bool isPalindrome(string s) {
        int n=s.size();
        string str="";
        for(int i=0;i<n;i++){
            if(check(s[i])){
                if(s[i]>='A' && s[i]<='Z'){
                    str.push_back(tolower(s[i]));
                }
                else{
                    str.push_back(s[i]);
                }
            }
        }
        
        int size = str.size();
        int i=0;
        int j=size-1;
        while(i<j){
            if(str[i]!=str[j]){
                return false;
            }
            else{
                i++;
                j--;
            }
        }
        return true;
    }
};
